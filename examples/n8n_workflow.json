{
  "name": "Automated AI SDR: Find B2B Tech Stack Buying Signals & Generate Cold Emails",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 9
            }
          ]
        }
      },
      "name": "Schedule: Every Monday 9AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "id": "11111111-1111-1111-1111-111111111111"
    },
    {
      "parameters": {
        "url": "https://b2b-tech-stack-and-hiring-intent-signals.p.rapidapi.com/v1/signals/tech-stack",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "tech",
              "value": "vLLM"
            },
            {
              "name": "limit",
              "value": "10"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-RapidAPI-Key",
              "value": "PASTE_YOUR_RAPIDAPI_KEY_HERE"
            },
            {
              "name": "X-RapidAPI-Host",
              "value": "b2b-tech-stack-and-hiring-intent-signals.p.rapidapi.com"
            }
          ]
        },
        "options": {}
      },
      "name": "Query B2B Hiring Signals API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        480,
        300
      ],
      "id": "22222222-2222-2222-2222-222222222222",
      "notes": "🔑 Get your Free API Key at https://rapidapi.com/your-org/api/b2b-tech-stack-and-hiring-intent-signals"
    },
    {
      "parameters": {
        "jsCode": "const signals = $input.first().json.signals || [];\nconst output = [];\n\nfor (const s of signals) {\n  const message = `🔥 *[AI SDR High-Intent Lead]*\\n` +\n    `🏢 *Company:* ${s.company_name} (${s.domain})\\n` +\n    `💼 *Role:* ${s.job_title}\\n` +\n    `⚙️ *Tech Stack:* ${s.extracted_signals.tech_stack_detected.join(', ')}\\n` +\n    `💰 *Comp:* ${s.extracted_signals.budget_tier_estimate}\\n` +\n    `💡 *Pain Point:* ${s.extracted_signals.pain_points_inferred[0] || 'N/A'}\\n` +\n    `🎯 *Pitch Angle:* ${s.recommended_pitch_angle}\\n` +\n    `🔗 *Link:* ${s.job_url}`;\n  output.push({ json: { text: message, company: s.company_name, domain: s.domain } });\n}\n\nreturn output;"
      },
      "name": "Format Cold Outreach Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "id": "33333333-3333-3333-3333-333333333333"
    }
  ],
  "connections": {
    "Schedule: Every Monday 9AM": {
      "main": [
        [
          {
            "node": "Query B2B Hiring Signals API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query B2B Hiring Signals API": {
      "main": [
        [
          {
            "node": "Format Cold Outreach Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
